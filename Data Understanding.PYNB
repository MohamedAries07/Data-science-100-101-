  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 7. Target Variable: Carbon Score Distribution"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Histogram\naxes[0].hist(df['carbon_score'], bins=40, color='#2E86AB', edgecolor='white', alpha=0.85)\naxes[0].axvline(df['carbon_score'].mean(), color='red', linestyle='--', linewidth=2, label=f\"Mean={df['carbon_score'].mean():.0f}\")\naxes[0].set_title('Carbon Score Distribution', fontsize=13, fontweight='bold')\naxes[0].set_xlabel('Carbon Score (kg COâ‚‚/month)')\naxes[0].set_ylabel('Frequency')\naxes[0].legend()\n\n# Box plot\naxes[1].boxplot(df['carbon_score'].dropna(), patch_artist=True,\n               boxprops=dict(facecolor='#2E86AB', color='navy'),\n               medianprops=dict(color='red', linewidth=2))\naxes[1].set_title('Carbon Score Box Plot', fontsize=13, fontweight='bold')\naxes[1].set_ylabel('Carbon Score (kg COâ‚‚/month)')\naxes[1].set_xticks([1])\naxes[1].set_xticklabels(['carbon_score'])\n\nplt.suptitle('Target Variable Overview', fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()\n\nprint(f\"\\nStatistics:\")\nprint(f\"  Mean   : {df['carbon_score'].mean():.2f}\")\nprint(f\"  Median : {df['carbon_score'].median():.2f}\")\nprint(f\"  Std    : {df['carbon_score'].std():.2f}\")\nprint(f\"  Min    : {df['carbon_score'].min():.2f}\")\nprint(f\"  Max    : {df['carbon_score'].max():.2f}\")"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
