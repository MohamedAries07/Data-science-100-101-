  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["missing = df.isnull().sum()\nmissing_pct = (missing / len(df) * 100).round(2)\nmissing_df = pd.DataFrame({'Missing Count': missing, 'Missing %': missing_pct})\nprint(missing_df[missing_df['Missing Count'] > 0])"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
